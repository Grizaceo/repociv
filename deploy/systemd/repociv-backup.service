[Unit]
Description=RepoCiv state/config backup
Documentation=file:%h/.hermes/workspace/ACTIVE/repociv/deploy/systemd/README.md
After=repociv-bridge.service

[Service]
Type=oneshot
WorkingDirectory=%h/.hermes/workspace/ACTIVE/repociv
EnvironmentFile=-%h/.hermes/workspace/ACTIVE/repociv/.env
ExecStart=%h/.hermes/workspace/ACTIVE/repociv/scripts/repociv-backup.sh
NoNewPrivileges=true
