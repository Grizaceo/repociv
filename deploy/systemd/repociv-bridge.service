# ⚠ LEGACY — superado por repociv.service (supervisor: scripts/dev-start.sh).
# No instalar: apunta a %h/.hermes/workspace/repos/repociv (path inexistente),
# usa el python del sistema (sin .venv/fastapi) y duplicaría el arranque del
# bridge. Referencia histórica: ver README.md de este directorio.
[Unit]
Description=RepoCiv Bridge Server (Backend API)
Documentation=file:%h/.hermes/workspace/repos/repociv/deploy/systemd/README.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/workspace/repos/repociv
ExecStart=/usr/bin/python3 -m server.bridge
Restart=on-failure
RestartSec=5
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.hermes/workspace/repos/repociv

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=repociv-bridge

# Security hardening (opcional)
NoNewPrivileges=true

[Install]
WantedBy=default.target
