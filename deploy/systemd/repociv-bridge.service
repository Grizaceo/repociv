[Unit]
Description=RepoCiv Bridge Server (Backend API)
Documentation=file:%h/.hermes/workspace/ACTIVE/repociv/deploy/systemd/README.md
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.hermes/workspace/ACTIVE/repociv
EnvironmentFile=-%h/.hermes/workspace/ACTIVE/repociv/.env
ExecStart=%h/.miniconda/bin/python3 -m server.bridge
Restart=on-failure
RestartSec=5
Environment=PATH=%h/.miniconda/bin:/usr/local/bin:/usr/bin:/bin:/usr/lib/wsl/lib
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.hermes/workspace/ACTIVE/repociv

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=repociv-bridge

# Security hardening (opcional)
NoNewPrivileges=true

[Install]
WantedBy=default.target
