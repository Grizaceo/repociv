{
  "name": "repociv",
  "version": "0.1.0",
  "type": "module",
  "description": "Civilization-style hex map of ~/.hermes/workspace/repos/ \u2014 agents are units, background processes are buildings",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run && vite build",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "start": "bash scripts/dev-start.sh",
    "stop": "bash scripts/dev-stop.sh",
    "health": "bash scripts/healthcheck.sh",
    "backup": "bash scripts/backup-events.sh",
    "assets:3d": "bash scripts/generate-3d-textures.sh",
    "assets:office": "python3 scripts/generate-office-atlas.py",
    "assets:props": "python3 scripts/blender/make_props.py && python3 scripts/blender/make_props_vegetation.py && python3 scripts/blender/make_props_city.py",
    "assets": "npm run assets:3d && npm run assets:office",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.175.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "knip": "^6.41.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.16.0",
    "three": "^0.175.0",
    "valibot": "^1.5.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.19",
    "postcss": "^8.5.23",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2"
  }
}
